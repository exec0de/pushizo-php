{
  "name": "herosignal/herosignal-php",
  "description": "HeroSignal PHP sunucu SDK'sı: public API'nin tamamı (bildirim, kullanıcı, segment, şablon, kampanya, analitik, veri aktarımı, webhook…)",
  "type": "library",
  "license": "MIT",
  "version": "0.1.0",
  "homepage": "https://github.com/exec0de/herosignal/tree/main/sdk/php",
  "keywords": [
    "herosignal",
    "push",
    "notifications",
    "email",
    "sms",
    "webhooks"
  ],
  "authors": [
    {
      "name": "HeroSignal",
      "homepage": "https://github.com/exec0de/herosignal"
    }
  ],
  "support": {
    "issues": "https://github.com/exec0de/herosignal/issues",
    "source": "https://github.com/exec0de/herosignal/tree/main/sdk/php",
    "docs": "https://github.com/exec0de/herosignal/blob/main/docs/sdk/php.md"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "HeroSignal\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "for f in src/*.php src/**/*.php tests/*.php; do php -l $f; done"
  }
}
