{
  "name": "pushizo/pushizo-php",
  "description": "Pushizo PHP sunucu SDK'sı: public API'nin tamamı (bildirim, kullanıcı, segment, şablon, kampanya, analitik, veri aktarımı, webhook…)",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.pushizo.com/docs/sdk/php",
  "keywords": [
    "pushizo",
    "push",
    "notifications",
    "email",
    "sms",
    "webhooks"
  ],
  "authors": [
    {
      "name": "Pushizo",
      "homepage": "https://pushizo.com"
    }
  ],
  "support": {
    "issues": "https://github.com/pushizo/pushizo-php/issues",
    "source": "https://github.com/pushizo/pushizo-php",
    "docs": "https://docs.pushizo.com/docs/sdk/php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Pushizo\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "for f in src/*.php src/**/*.php tests/*.php; do php -l $f; done"
  }
}
